---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" style={`--slider-pattern-image: url('${import.meta.env.BASE_URL}img/slider-pattern.svg')`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<base href={import.meta.env.BASE_URL} />

		<link rel="icon" type="image/x-icon" sizes="any" href={`${import.meta.env.BASE_URL}favicons/favicon.ico`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL}favicons/favicon_16x16.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicons/favicon-32x32.png`}>
    <link rel="icon" type="image/png" sizes="180x180" href={`${import.meta.env.BASE_URL}favicons/favicon-180x180.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}favicons/favicon-192x192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${import.meta.env.BASE_URL}favicons/favicon-512x512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}favicons/favicon-180x180.png`} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
		<ViewTransitions />
	</head>
	<body>
		<slot />
	</body>
</html>
