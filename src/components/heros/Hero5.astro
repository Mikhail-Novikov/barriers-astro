---
import { publicAsset } from "@utils/publicAsset";
import Video from "@components/Video";

const cards = [
  {
    image: '/img/reliability-security/rs-1.webp',
    notification: true,
    title: 'Датчики вскрытия корпуса',
    description: 'Датчик открытия дверцы позволяет <b class="font-manrope-semibold">отслеживать несанкционированный доступ</b> к&nbsp;внутренним элементам шлагбаума, включая механизм ручного поднятия стрелы. <b class="font-manrope-semibold">Уведомление о взломе</b> мгновенно поступает на пульт охраны.',
  },
  {
    image: '/img/reliability-security/rs-2.webp',
    title: 'Аварийное открытие',
    description: 'Для свободного проезда в&nbsp;экстренной ситуации к&nbsp;шлагбауму подключается устройство аварийного открытия.',
  },
  {
    image: '/img/reliability-security/rs-3.webp',
    title: 'Сигнальная индикация',
    description: '<p class="mb-3 md:mb-5">На&nbsp;шлагбаум может дополнительно устанавливаться сигнальная лампа.</p> <p><b class="font-manrope-semibold">Модели GS04.1</b> и <b class="font-manrope-semibold">GS06.1</b> имеют встроенную сигнальную индикацию.</p>',
  },
  {
    isVideo: true,
    title: 'Защита от наезда и&nbsp;механического воздействия',
    description: 'Стрела оснащена пластиковыми предохранителями: при критической нагрузке на&nbsp;стрелу они разрушаются, стрела отсоединяется, при этом механизм и&nbsp;тумба не&nbsp;повреждаются.',
  },
];
---

<section aria-label="Надежность и безопасность" class="bg-grey-400 py-10 sm:py-15 lg:p-[60px_0_80px] xl:p-[80px_0_100px]">
  <div class="container">
    <h2 class="mb-6 h2 xl:mb-8">Надежность и&nbsp;безопасность</h2>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4 xl:gap-5">
      {cards.map((card) => (
        <article class="flex flex-col min-w-0 overflow-hidden rounded-2xl lg:rounded-3xl bg-grey-200">
          <div class="relative aspect-[1.39] w-full">
            {!card.isVideo ? (
              <img
                class="object-cover w-full h-full"
                src={publicAsset(`${card.image}`)}
                alt={card.title}
                loading="lazy"
              />
            ) : (
              <Video client:load containerClassName="h-full w-full" className="h-full w-full object-cover"
                src={publicAsset('/video/reliability-security/rs4-video.mp4')}
                poster={publicAsset("/img/reliability-security/rs-4.webp")}
                muted
                autoPlay
                preload="auto"
                playsInline
                loop
                playButtonVisibility="hidden"
              />
            )}
            {card.notification && (
              <div class="perco-icons absolute bottom-2 right-2 z-10 flex min-w-0 flex-col rounded-lg bg-white px-3 py-2 shadow-[0_1px_5px_rgba(0,0,0,0.22)] pointer-events-none md:py-3 pr-5 md:text-xs/[1.3]">
                <div class="flex items-start justify-between gap-1 mr-3 font-bold">
                  <span class="text-sm/4 sm:text-md/5 font-roboto-semibold">Реакция на событие</span>
                  <span class="absolute top-1 right-1 sm:top-2 sm:right-2 shrink-0 font-manrope-bold text-grey-800 text-sm/5" aria-hidden="true"><i class="perco-icon-close"></i></span>
                </div>
                <span class="text-[12px]/[1.3] sm:text-sm/5 font-roboto">Вскрыт корпус шлагбаума!</span>
              </div>
            )}
          </div>
          <div class="p-5 space-y-2 sm:space-y-3 3xl:p-[40px_28px_32px_32px] text-grey-1000">
            <h3 class="h3" set:html={card.title} />
            <p class="font-normal text-sm/5 2xl:text-md/6" set:html={card.description} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
