---
import rs1 from '../../assets/img/reliability-security/rs-1.png';
import rs2 from '../../assets/img/reliability-security/rs-2.png';
import rs3 from '../../assets/img/reliability-security/rs-3.png';
import rs4 from '../../assets/video/reliability-security/rs4-video.mp4';

import { publicAsset } from "@utils/publicAsset";

const cards = [
  {
    image: rs1,
    notification: true,
    title: 'Датчики вскрытия корпуса',
    description: 'Датчик открытия дверцы позволяет <b class="font-manrope-semibold">отслеживать несанкционированный доступ</b> к внутренним элементам шлагбаума, включая механизм ручного поднятия стрелы. <b class="font-manrope-semibold">Уведомление о взломе</b> мгновенно поступает на пульт охраны.',
  },
  {
    image: rs2,
    title: 'Аварийное открытие',
    description: 'Для свободного проезда в экстренной ситуации к шлагбауму подключается устройство аварийного открытия.',
  },
  {
    image: rs3,
    title: 'Сигнальная индикация',
    description: '<p class="mb-5">На шлагбаум может дополнительно устанавливаться сигнальная лампа.</p> <p><b class="font-manrope-semibold">Модели GS04.1</b> и <b class="font-manrope-semibold">GS06.1</b> имеют встроенную сигнальную индикацию.</p>',
  },
  {
    isVideo: true,
    pathVideo: rs4,
    title: 'Защита от наезда и механического воздействия',
    description: 'Стрела оснащена пластиковыми предохранителями: при критической нагрузке на стрелу они разрушаются, стрела отсоединяется, при этом механизм и тумба не повреждаются.',
  },
];
---

<section aria-label="Надежность и безопасность" class="bg-grey-400 pt-10 md:pt-15 xl:pt-20 pb-10 md:pb-15 lg:pb-20 xl:pb-25">
  <div class="container">
    <h2 class="h2 mb-6 lg:mb-8">Надежность и безопасность</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {cards.map((card) => (
        <article class="flex min-w-0 flex-col overflow-hidden rounded-3xl bg-grey-200">
          <div class="relative aspect-[1.39] w-full">
            {!card.isVideo ? (
              <img
                class="h-full w-full object-cover"
                src={card.image?.src}
                alt={card.title}
                loading="lazy"
              />
            ) : (
              <video class="h-full w-full object-cover" src={card.pathVideo} 
                muted
                autoplay
                preload="auto"
                poster={publicAsset("/img/reliability-security/rs-4.webp")}
                playsinline
                loop />
            )}
            {card.notification && (
              <div class="perco-icons absolute bottom-3 right-3 z-10 flex min-w-0 flex-col rounded-lg bg-white px-3 py-2 shadow-[0_1px_5px_rgba(0,0,0,0.22)] pointer-events-none sm:py-3 pr-5 sm:text-xs/[1.3]">
                <div class="flex items-start justify-between gap-1 font-bold mr-3">
                  <span class="text-md/5">Реакция на событие</span>
                  <span class="absolute top-2 right-2 shrink-0 font-[1000] text-grey-800 text-sm/5" aria-hidden="true"><i class="perco-icon-close"></i></span>
                </div>
                <span class="text-sm">Вскрыт корпус шлагбаума!</span>
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col gap-y-2 p-5 3xl:px-7 3xl:py-9 text-grey-1000">
            <h4 class="text-lg/6 sm:text-xl/6 font-manrope-semibold">{card.title}</h4>
            <div class="font-normal mb-5" set:html={card.description} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
