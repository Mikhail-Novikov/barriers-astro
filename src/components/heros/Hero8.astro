---
import { publicAsset } from '../../utils/publicAsset';

const cards = [
  {
    image: publicAsset('/img/methods-controlling-barrier/mcb-1.webp'),
    title: 'Управление от пульта',
    description: 'Доступ может осуществляться с помощью пульта дистанционного управления, радиобрелоков или от кнопки открыть/закрыть.',
  },
  {
    image: publicAsset('/img/methods-controlling-barrier/mcb-2.webp'),
    title: 'СКУД и&nbsp;парковочная система',
    description: 'Для доступа транспортных средств могут использоваться различные идентификаторы, например, бесконтактные карты, смартфоны с&nbsp;NFC и&nbsp;BLE, RFID-метки.',
  },
  {
    image: publicAsset('/img/methods-controlling-barrier/mcb-3.webp'),
    title: 'Распознавание номеров',
    description: 'Установленная система видеонаблюдения позволяет реализовывать контроль доступа по&nbsp;распознаванию номеров.',
  },
  {
    image: publicAsset('/img/methods-controlling-barrier/mcb-4.webp'),
    title: 'Свободный выезд',
    description: 'Для организации свободного выезда с&nbsp;территории устанавливается магнитная петля.',
  },
  {
    image: publicAsset('/img/methods-controlling-barrier/mcb-5.webp'),
    title: 'Мобильное приложение',
    description: 'Шлагбаум синхронизируется со&nbsp;смартфоном с&nbsp;помощью Bluetooth. При синхронизации однократно вводится пароль доступа, впоследствии шлагбаум будет открываться нажатием одной кнопки в&nbsp;приложении.',
  },
  {   
    image: publicAsset('/img/methods-controlling-barrier/mcb-6.webp'), 
    title: 'Звонок со&nbsp;смартфона',
    description: 'При наборе определенного номера звонок сбрасывается, а&nbsp;шлагбаум открывается для проезда. Список номеров для управления шлагбаумом редактируется с&nbsp;помощью СМС или приложения PERCo.Конфигурация.',
  },
];
---

<section id="management" aria-label="Способы управления шлагбаумом" class="bg-white pt-10 md:pt-15 xl:pt-20 pb-10 md:pb-15 lg:pb-20 xl:pb-25">
  <div class="container">
    <div class="flex flex-col gap-9">
      <h3 class="h2">Способы управления шлагбаумом</h3>

      <div class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-5 lg:gap-y-10">
        {cards.map((card) => (
          <article class="flex min-w-0 flex-col">
            <img
              class="aspect-[1.94] w-full rounded-t-3xl object-cover"
              src={card.image}
              alt={card.title}
              loading="lazy"
            />
            <div class="flex flex-1 flex-col gap-3 2xl:mr-10 pt-5 text-grey-1000">
              <h4 class="h4" set:html={card.title} />
              <p class="text-md/6" set:html={card.description} />
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
