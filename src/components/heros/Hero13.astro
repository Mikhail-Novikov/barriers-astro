---
import FeedbackForm from './FeedbackForm';
import { publicAsset } from '../../utils/publicAsset';
---

<section aria-label="Остались вопросы?" class="bg-grey-200 p-[40px_0_60px] lg:pt-20 lg:pb-[108px]">
  <div class="container">
    <div class="grid grid-cols-1 sm:gap-8 lg:grid-cols-2 items-start">
      <div class="flex flex-col justify-center gap-6">
        <img 
          src={publicAsset('/img/ill-feedback.webp')}
          alt="Техническая поддержка" 
          class="sm:order-1 block mt-0 sm:mt-20 m-auto sm:ml-19 h-auto w-full max-w-[127px] sm:max-w-md object-contain"
          loading="lazy"
        />
        <h2 class="my-1 text-2xl/8 sm:text-[60px]/16 font-normal text-center sm:text-left sm:text-grey-700">Остались вопросы?</h2>
      </div>
      <div class="lg:ml-3">
        <FeedbackForm client:load idPrefix="feedback-page" />
      </div>
    </div>
  </div>
</section>
