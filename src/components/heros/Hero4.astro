---
import { publicAsset } from '../../utils/publicAsset';
import Video from '@components/Video';

const climateCards = [
  {
    title: 'Скоростные модели',
    subtitle: 'для интенсивного транспортного потока',
    icon: 'perco-icon-highspeed',
    textClass: '4xl:w-1/2',
    paragraph: [
      { text: 'Модели шлагбаумов  GF13, GF13N и GF03.1', strong: true },
      { text: ' предназначены для установки на\u00a0платных парковках, автомагистралях, в\u00a0аэропортах, на\u00a0железнодорожных вокзалах, в\u00a0бизнес-центрах и\u00a0других объектах с\u00a0высокой нагрузкой.' },
    ],
    features: [
      {
        title: 'Скоростной механизм',
        text: ' обеспечивает время поднятия стрелы 0,7-1,5 cекунд.',
      },
      {
        title: 'Буфер из\u00a0пеноматериала со\u00a0светоотражающими наклейками',
        text: 'служит для дополнительной защиты стрелы и\u00a0корпуса автомобиля.',
        separateText: true,
        className: 'mb-0',
      },
    ],
    mediaClass: '4xl:w-1/2',
    media: {
      type: 'video' as const,
      src: publicAsset('/video/picking/high-barrier.mp4'),
      poster: publicAsset('/img/picking/high-throughput.webp'),
    },
  },
  {
    title: 'Морозостойкие модели',
    subtitle: 'для экстремально низких температур',
    icon: 'perco-icon-frostresistant',
    textClass: '4xl:w-1/2 4xl:order-1',
    paragraph: [
      { text: 'Модели шлагбаумов  линеек GF13N и GS14N ', strong: true },
      { text: 'имеют морозоустойчивый корпус, который обеспечивает стабильную работу при температуре до\u00a0' },
      { text: '-60°C.', strong: true },
    ],
    features: [
      { title: 'Дополнительный обогрев', text: ' корпуса.' },
      { title: 'Утепеление стойки', text: ' фольгированным пеноматериалом.' },
      {
        title: 'Специальная морозостойкая марка стали 09Г2С',
        text: ' обеспечивает повышенную коррозийную стойкость.',
      },
      {
        title: 'Модель GF13N ',
        text: 'сочетает морозостойкий корпус с\u00a0высокоскоростным механизмом.',
      },
    ],
    mediaClass: 'min-w-0 4xl:w-1/2',
    media: {
      type: 'image' as const,
      alt: 'Модели шлагбаумов линеек GF13N и GS14N',
      sources: [
        { srcset: '/img/picking/frost‑resistant.webp', media: '(min-width: 1920px)' },
        { srcset: '/img/picking/frost‑resistant-1600.webp', media: '(min-width: 1600px)' },
        { srcset: '/img/picking/frost‑resistant-1400.webp', media: '(min-width: 1400px)' },
        { srcset: '/img/picking/frost‑resistant-1200.webp', media: '(min-width: 1200px)' },
        { srcset: '/img/picking/frost‑resistant-1019.webp', media: '(min-width: 1019px)' },
        { srcset: '/img/picking/frost‑resistant-712.webp', media: '(min-width: 712px)' },
        { srcset: '/img/picking/frost‑resistant-600.webp', media: '(min-width: 600px)' },
      ],
      fallback: '/img/picking/frost‑resistant-375.webp',
    },
  },
];

const wrapperStyle = "p-[20px_12px] sm:p-[32px_20px] md:p-[32px_32px_40px_32px] xl:p-[28px_28px_32px_28px] 3xl:p-[32px_32px_40px_32px] 4xl:p-[40px_40px_52px_40px]";
---

<section aria-label="Решения для любого климата и нагрузки" class="p-[40px_0_60px] xl:p-[40px_0_80px] 2xl:p-[40px_0_100px] 2xl:pt-10 4xl:pb-30 4xl:pt-8 bg-white">
  <div class="container">
    <div class="gap-5 space-y-4 xl:flex 4xl:gap-7 perco-icons">
      {climateCards.map((card) => (
        <div class={`flex flex-col items-start xl:w-1/2 sm:mb-5 xl:mb-0 bg-grey-200 border-transparent rounded-3xl ${wrapperStyle}`}>
          <div class="flex items-center gap-x-4 md:gap-x-6">
            <div class="shrink-0 size-13 md:size-15 bg-white rounded-[50%] flex items-center justify-center text-4xl md:text-[40px] text-cta">
              <i class={card.icon}></i>
            </div>
            <h3 class="h3">
              {card.title}
              <span class="block text-sm/5 sm:text-lg/6 font-manrope-semibold text-grey-900">
                {card.subtitle}
              </span>
            </h3>
          </div>
          <div class="flex flex-col justify-between flex-1 gap-5 mt-4 sm:gap-8 xl:gap-5 4xl:flex-row 4xl:space-y-8 sm:mt-7 text-md/6">
            <div class={card.textClass}>
              <p class="mb-4 md:mb-5 text-grey-1000">
                {card.paragraph.map((part) => (
                  part.strong
                    ? <span class="font-manrope-semibold">{part.text}</span>
                    : part.text
                ))}
              </p>
              <ul class="list-disc pl-6 space-y-2 text-grey-1000 marker:text-[12px]">
                {card.features.map((feature) => (
                  <li>
                    {'separateText' in feature && feature.separateText ? (
                      <>
                        <div class="font-manrope-semibold">{feature.title}</div>
                        <p>{feature.text}</p>
                      </>
                    ) : (
                      <p>
                        <span class="font-manrope-semibold">{feature.title}</span>
                        {feature.text}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
            <div class={card.mediaClass}>
              {card.media.type === 'video' ? (
                <Video
                  client:load
                  containerClassName="w-full h-[236px] sm:h-[360px] rounded-[16px] sm:rounded-2xl overflow-hidden cursor-pointer"
                  className="w-full h-auto min-h-full object-cover rounded-2xl"
                  src={card.media.src}
                  poster={card.media.poster}
                  muted
                  autoPlay
                  preload="auto"
                  playsInline
                  loop
                  playButtonVisibility="hidden"
                />
              ) : (
                <picture class="w-full">
                  {card.media.sources.map((source) => (
                    <source
                      srcset={publicAsset(source.srcset)}
                      media={source.media}
                      type="image/webp"
                    />
                  ))}
                  <img
                    class="w-full rounded-2xl"
                    srcset={publicAsset(card.media.fallback)}
                    alt={card.media.alt}
                  />
                </picture>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
