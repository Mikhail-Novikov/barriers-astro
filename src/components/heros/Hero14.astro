---

import AboutCarousel from './AboutCarousel';
import AboutCarouselStacked from './AboutCarouselStacked';
import about from '@content/about.json';
import { publicAsset } from '@utils/publicAsset';

const aboutImages = about.images.map((image) => ({
  ...image,
  src: publicAsset(`/img/about/${image.src}`),
}));
---

<section aria-label="О компании" class="pb-10 bg-grey-200 md:pb-15 xl:pb-20 lg:pb-25">
  <div class="md:container">
    <div class="flex flex-col gap-8 rounded-[20px] sm:rounded-5xl bg-white p-[40px_16px_60px] sm:p-[40px_32px_60px] lg:p-[80px_40px_100px] 3xl:p-[80px_80px_100px] 5xl:px-20 sm:mx-auto 3xl:-mx-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="container mx-0 sm:mx-auto">
          <h2 class="mb-5 h2 sm:mb-8">О компании</h2>
          <ul class="flex gap-x-6 sm:gap-x-12">
            <li>
              <strong class="text-[40px]/12 sm:text-5xl/14 lg:text-7xl/18 font-bold font-inter-bold leading-none text-grey-800">5</strong>
              <div class="mt-2 text-md/6 md:text-lg text-grey-700">лет гарантии</div>
            </li>
            <li>
              <strong class="text-[40px]/12 sm:text-5xl/14 lg:text-7xl/18 font-bold font-inter-bold leading-none text-grey-800">38</strong>
              <div class="mt-2 text-md/6 md:text-lg text-grey-700">лет на рынке</div>
            </li>
            <li>
              <strong class="text-[40px]/12 sm:text-5xl/14 lg:text-7xl/18 font-bold font-inter-bold leading-none text-grey-800">96</strong>
              <div class="mt-2 text-md/6 md:text-lg text-grey-700">стран продаж</div>
            </li> 
          </ul>
        </div>

        <div class="container mx-0 space-y-6 sm:mx-auto text-grey-700 text-md/6 lg:text-lg/6">
          <p><strong class="font-manrope-semibold text-grey-1000">PERCo специализируется на&nbsp;серийном производстве оборудования и&nbsp;систем безопасности</strong> собственной разработки&nbsp;с1988&nbsp;года. Сегодня PERCo&nbsp;&mdash; лидер в&nbsp;производстве систем контроля доступа и&nbsp;дорожной автоматики.</p>
          <p>Высокое качество обеспечило продукции PERCo <strong class="font-manrope-semibold text-grey-1000">признание как в&nbsp;России, так и&nbsp;за&nbsp;рубежом.</strong> Система менеджмента качества PERCo сертифицирована на&nbsp;соответствие международным стандартам ISO 9001:2015.</p>
          <p>Собственное производство PERCo оснащено современным <strong class="font-manrope-semibold text-grey-1000">высокоточным и&nbsp;высокотехнологичным оборудованием</strong>, что позволяет разрабатывать, выпускать и&nbsp;успешно представлять на&nbsp;рынке широкий ассортимент товаров, отвечающих мировым стандартам.</p>
        </div>
      </div>

      <div class="container mx-0 sm:mx-auto">
        <div class="hidden lg:block">
          <AboutCarousel images={aboutImages} client:load />
        </div>
        <div class="lg:hidden">
          <AboutCarouselStacked images={aboutImages} client:load />
        </div>
      </div>

    </div>
  </div>
</section>
