---
import sm1 from '../../assets/img/setup-maintenance/sm-1.png';
import sm1_mobile_1400 from '../../assets/img/setup-maintenance/sm-1-mobile.png';
import sm2 from '../../assets/img/setup-maintenance/sm-2.png';

const cards = [
  {
    image: sm1,
    imageMobile1400: sm1_mobile_1400,
    title: 'Встроенный блок управления',
    description: '<p>Удобный доступ к&nbsp;блоку управления обеспечивает его простое обслуживание.</p><p>Датчик открытия дверцы позволяет отслеживать несанкционированный доступ к&nbsp;внутренним элементам шлагбаума, включая механизм ручного поднятия стрелы.<br>Монтажные швеллеры и&nbsp;пластины идут в&nbsp;комплекте.</p>',
    imagePosition: 'left' as const,
  },
  {
    image: sm2,
    imageMobile1400: null,
    title: 'Настройка через<br>мобильное приложение',
    description: '<p>Мобильное приложение для настройки шлагбаума устанавливается на&nbsp;смартфон администратора, отвечающего за&nbsp;управление работой шлагбаума.</p><p>Для настройки шлагбаума используются технологии беспроводной передачи данных Bluetooth. Команды от&nbsp;приложения поступают в&nbsp;плату управления шлагбаума через модуль GSM&nbsp;/ BLE.</p>',
    imagePosition: 'right' as const,
  },
];
---

<section aria-label="Удобство настройки и обслуживания" class="bg-grey-400 p-[40px_0_60px] sm:py-15 xl:p-[60px_0_80px] 3xl:p-[80px_0_100px] 4xl:pb-30">
  <div class="container">
    <div>
      <h2 class="mb-6 h2 xl:mb-8">Удобство настройки и обслуживания</h2>

      <div class="min-w-0 pb-2 overflow-x-auto">
        <div class="grid md:min-w-[923px] md:grid-cols-2 gap-5 3xl:gap-6">
          {cards.map((card) => (
            <article class={`flex min-w-0 flex-col sm:gap-8 4xl:gap-10 overflow-hidden rounded-3xl bg-white p-6 xl:p-8 4xl:p-10 2xl:flex-row ${card.imagePosition === 'right' ? '2xl:flex-row-reverse' : ''}`}>
              <div class="flex-shrink-0 mb-8 md:mb-0 2xl:w-6/12">
                <picture>
                  {card.imageMobile1400 && (
                    <source media="(max-width: 1400px)" srcset={card.imageMobile1400.src} />
                  )}
                  <img
                    class={`sm:h-[310px] 4xl:h-[380px] rounded-2xl object-cover ${card.imagePosition === 'right' ? 'm-auto h-[310px]' : 'h-[191px]'}`}
                    src={card.image.src}
                    alt={card.title}
                    loading="lazy"
                  />
                </picture>
              </div>
              <div class="flex flex-col flex-1 gap-3 text-grey-1000 2xl:w-6/12">
                <h3 class="h3" set:html={card.title} />
                <div class="flex flex-col whitespace-pre-line gap-y-3 text-md/6" set:html={card.description} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
